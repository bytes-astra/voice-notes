{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoiceNotes",
  "version": "0.1.5",
  "identifier": "com.hugh.voicenotes",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "语音转文字",
        "label": "main",
        "width": 980,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#f3f4f7",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "本地语音转文字（SenseVoiceSmall INT8）",
    "longDescription": "使用 SenseVoiceSmall INT8 在本机把语音转成文字，支持中英粤日韩，不需要联网。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}